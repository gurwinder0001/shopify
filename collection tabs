<!-- Slick Slider CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

<!-- Slick Slider JS -->
<script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<section id="{{ section.id }}" style="padding-top:{{ section.settings.paddingtop }}px; padding-bottom:{{ section.settings.paddingbottom }}px">
  <div class="custommains page-width">
    <div class="secondmains">
      <div class="addcontents {{ section.settings.custclass }}">
        <h2 style="font-size:{{ section.settings.headingsize }}px; color:{{ section.settings.headingcolor }}">{{ section.settings.heading }}</h2>
      </div>
      <div class="collectionlistcustomd-wrapper">
        <div class="collectionlistcustomd">
          {% for block in section.blocks %}
            <a class="collectionse" href="{{ block.settings.collectionurl }}">
              <div class="imageees"><img src="{{ block.settings.imagecont | img_url:'master' }}" alt="{{ block.settings.title }}"></div>
              <div class="collection-titless"><p style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.titlecolor }}">{{ block.settings.title }}</p></div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>



<style>

.imageees img {
    width: 100%;
}
  
  / Desktop Styles /
@media only screen and (min-width: 1024px) {
  / Slick Slider Styles for Desktop /
  #{{ section.id }} .collectionlistcustomd {
    display: flex;
    justify-content: flex-start; / Aligns the slides to the left /
    gap: 10px; / Adds spacing between slides /
  }

  / Ensure the collection items maintain consistent width /
  #{{ section.id }} .collectionse {
    flex: 0 0 auto; / Prevents shrinking /
  }

  / Customize the scrollbar for desktop /
  #{{ section.id }} .slick-slider {
    overflow: hidden; / Hide overflow (vertical scroll) /
    position: relative;
  }

  / Slick previous and next buttons /
  #{{ section.id }} .slick-prev,
  #{{ section.id }} .slick-next {
    background-color: #ae0078;
    padding: 10px;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    border: none;
    cursor: pointer;
    position: absolute;
    top: 40%;
    z-index: 10;
  }

  #{{ section.id }} .slick-prev {
    left: -3%;
  }

  #{{ section.id }} .slick-next {
    right: -3%;
  }

  #{{ section.id }} .slick-prev:hover, .slick-next:hover {
    background-color: white;
    color: #ae0078;
  }

  / Dot navigation styles for desktop /
  #{{ section.id }} ul.slick-dots {
    display: block; / Show dots for desktop /
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
  }

  #{{ section.id }} ul.slick-dots li button {
    font-size: 10px;
    color: #ae0078;
  }

  #{{ section.id }} ul.slick-dots li.slick-active button {
    color: #f0f0f0;
  }

  / Ensuring the proper alignment and height for the items /
  #{{ section.id }} .slick-slide {
    padding: 10px; / Adds space around the images /
  }

  #{{ section.id }} .collection-titless p {
    text-align: center;
    font-size: 15px;
    font-weight: 700;
    margin-top: 6px;
  }
}


@media only screen and (max-width: 767px) {

    #{{ section.id }} .collectionse {
        flex: 1 0 auto !important;
        flex-basis: 24% !important;
    }
  
 #{{ section.id }} .imageees img {
    width: 100%;
}
  .collection-titless p {
    text-align: center;
    line-height: normal;
    font-weight: 400;
}
  
  / Hide the previous and next buttons /
  #{{ section.id }} .slick-prev,
  #{{ section.id }} .slick-next {
    display: none !important;
  }

  / Hide the dots /
  #{{ section.id }} ul.slick-dots {
    display: none !important;
  }

  / Add horizontal scroll behavior /
  #{{ section.id }} .collectionlistcustomd-wrapper {
    overflow-x: auto; / Enables horizontal scrolling /
    display: flex;
    padding-bottom: 10px; / Space for scrollbar /
    scrollbar-width: thin;
    scrollbar-color: #ae0078 transparent;
  }

  / Webkit Scrollbar Styling /
  #{{ section.id }} .collectionlistcustomd-wrapper::-webkit-scrollbar {
    height: 8px; / Scrollbar thickness /
  }

  #{{ section.id }} .collectionlistcustomd-wrapper::-webkit-scrollbar-thumb {
    background-color: #ae0078; / Scrollbar color /
    border-radius: 10px; / Rounded corners /
  }

  #{{ section.id }} .collectionlistcustomd-wrapper::-webkit-scrollbar-track {
    background: #f0f0f0; / Background of the scrollbar track /
    border-radius: 10px; / Rounded corners /
  }

  / Make the items scrollable in one row /
  #{{ section.id }} .collectionlistcustomd {
    display: flex;
    gap: 10px; / Adds spacing between items /
  }

  / Ensure each slide is aligned properly for scrolling /
  #{{ section.id }} .collectionse {
    flex: 0 0 auto; / Prevents shrinking of slides /
  }
  
}


</style>



<script>
 $(document).ready(function() {
  // Only initialize Slick for larger screens (above 767px)
  if ($(window).width() > 767) {
    $('.collectionlistcustomd').slick({
      infinite: true,
      dots: true, 
      slidesToShow: 6,
      slidesToScroll: 1, 
      autoplay: true,
      autoplaySpeed: 2000,
      prevArrow: '<button class="slick-prev">&#10094;</button>',
      nextArrow: '<button class="slick-next">&#10095;</button>',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1
          }
        }
      ]
    });
  }
});

</script>


{% schema %}
  {
    "name": "Custom Multi Collection",
    "settings": [
       {
        "type":"text",
        "id":"heading",
        "label":"Collection Heading"
      },
       {
          "type": "text",
          "id": "headingsize",
          "label": "Heading Size ( PX )",
        },
       {
          "type": "color",
          "id": "headingcolor",
          "label": "Heading Color",
        },
       {
          "type": "text",
          "id": "titlesize",
          "label": "Title Size ( PX )",
        },
       {
          "type": "color",
          "id": "titlecolor",
          "label": "Title Color",
        },
      {
          "type": "text",
          "id": "paddingtop",
          "label": "Section Padding Top ( PX )",
        },
      {
          "type": "text",
          "id": "paddingbottom",
          "label": "Section Padding Bottom ( PX )",
        },
      {
        "type":"text",
        "id":"custclass",
        "label":"Add css"
      }
    ],
     "blocks": [
      	{
      "type": "collection",
      "name": "Add Custom Collections",
         
      "settings": [
        {
          "type": "image_picker",
          "id": "imagecont",
          "label": "Collection Image",
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection title",
        },
        {
          "type": "url",
          "id": "collectionurl",
          "label": "Collection Url",
        }
      ]
    }
  ]
    ,
    "presets":[
      {
        "name":"Custom Multi Collection"
      }
    ]
  }
{% endschema %}
