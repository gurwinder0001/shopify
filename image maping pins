<section id="{{ section.id }}" class="hotspot-section">
  <div class="custom-width">
    <div class="hotspot-image-wrapper">
      <img src="{{ section.settings.bg_image | image_url: width: 1600 }}" alt="Hotspot Background" class="hotspot-background">

      {% for block in section.blocks %}
        <div class="hotspot" style="top:{{ block.settings.hotspot_top }}%; left:{{ block.settings.hotspot_left }}%;" data-product="hotspot-{{ block.id }}">
          <span class="hotspot-dot"></span>
        </div>

        <!-- Popup Product Card -->
        <div id="hotspot-{{ block.id }}" class="hotspot-popup">
          {% assign product = all_products[block.settings.product] %}
          {% if product %}
            <div class="popup-card">
              <div class="popup-image">
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}">
              </div>
              <div class="popup-info">
                <h4 class="popup-title">{{ product.title }}</h4>
                <p class="popup-price">{{ product.price | money }}</p>

                {% if product.options_with_values.size > 0 %}
                  <div class="popup-variants">
                    {% for option in product.options_with_values %}
                      {% if option.name == 'Color' %}
                        <div class="variant-colors">
                          {% for value in option.values %}
                            <span class="variant-color" style="background-color: {{ value | handle }};"></span>
                          {% endfor %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <a href="{{ product.url }}" class="popup-button">View Product</a>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
#{{ section.id }} .custom-width{
 max-width:90%;
margin:0 auto;
}
#{{ section.id }}.hotspot-section {
  position: relative;
  padding: 0 0 40px;
}
#{{ section.id }} .hotspot-image-wrapper {
  position: relative;
  display: inline-block;
  width:100%;
}
#{{ section.id }} .hotspot-background {
  width: 100%;
  border-radius: 12px;
}
#{{ section.id }} .hotspot {
  position: absolute;
  transform: translate(-50%, -50%);
  cursor: pointer;
  z-index: 5;
}
#{{ section.id }} .hotspot-dot {
  width: 18px;
  height: 18px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #EC018E;
  box-shadow: 0 0 8px rgba(0,0,0,0.2);
  display: block;
  position: relative;
  z-index: 1;
}

/* ripple waves */
#{{ section.id }} .hotspot-dot::before,
#{{ section.id }} .hotspot-dot::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(236, 1, 142, 0.71); /* same pink with opacity */
  transform: translate(-50%, -50%) scale(1);
  opacity: 0.6;
  animation: hotspotWave 2s infinite ease-out;
  z-index: -1;
}

/* second wave delayed */
#{{ section.id }} .hotspot-dot::after {
  animation-delay: 1s;
}

@keyframes hotspotWave {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.6;
  }
  100% {
    transform: translate(-50%, -50%) scale(2.5);
    opacity: 0;
  }
}

#{{ section.id }} .hotspot-popup {
  display: none;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  max-width: 320px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  z-index: 10;
}
#{{ section.id }} .popup-card {
  text-align: center;
}
#{{ section.id }} .popup-image img {
  max-width: 100%;
  border-radius: 8px;
  border: 1px dashed #ccc;
}
#{{ section.id }} .popup-title {
  font-size: 18px;
  margin: 10px 0;
}
#{{ section.id }} .popup-price {
  font-size: 16px;
  font-weight: bold;
  color: #EC018E;
  margin-bottom: 12px;
}
#{{ section.id }} .variant-colors {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 12px;
}
#{{ section.id }} .variant-color {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid #ccc;
  display: inline-block;
}
#{{ section.id }} .popup-button {
  display: inline-block;
  padding: 10px 18px;
  background: #EC018E;
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
  transition: 0.3s;
}
#{{ section.id }} .popup-button:hover {
  background: #a90065;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const hotspots = document.querySelectorAll('.hotspot');
  const popups = document.querySelectorAll('.hotspot-popup');

  hotspots.forEach(hotspot => {
    hotspot.addEventListener('click', function() {
      const target = this.dataset.product;

      popups.forEach(p => p.style.display = 'none'); // Hide all popups
      document.getElementById(target).style.display = 'block';
    });
  });

  // Close popup when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.hotspot') && !e.target.closest('.hotspot-popup')) {
      popups.forEach(p => p.style.display = 'none');
    }
  });
});
</script>

{% schema %}
{
  "name": "Hotspot Product Popup",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "label": "Hotspot Top Position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "label": "Hotspot Left Position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hotspot Product Popup",
      "category": "Custom"
    }
  ]
}
{% endschema %}
