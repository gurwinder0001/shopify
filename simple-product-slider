<section id="{{ section.id }}" class="best-seller-section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="best-seller-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="best-seller-slider">
      {% assign collection_handle = section.settings.collection %}
      {% if collections[collection_handle] != blank %}
        {% for product in collections[collection_handle].products %}
          <div class="product-card">
            <div class="product-image">
              <a href="{{ product.url }}">
                {% if product.images.size > 1 %}
                  <img class="primary-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                  <img class="secondary-img" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title }}">
                {% else %}
                  <img class="primary-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                {% endif %}
              </a>

              {% if product.compare_at_price > product.price %}
                {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round %}
                  {% if discount_percentage >= 5 %}
                   <div class="discount-badge">
                    {{ discount_percentage }}% OFF
                   </div>
                  {% endif %}
               {% endif %}

            </div>
            <div class="product-info">
              <h4 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h4>
              <p class="product-price">
                {% if product.compare_at_price > product.price %}
                  <span class="old-price">{{ product.compare_at_price | money }}</span>
                  <span class="new-price">{{ product.price | money }}</span>
                {% else %}
                  <span class="new-price">{{ product.price | money }}</span>
                {% endif %}
              </p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p>No products found in this collection.</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
#{{ section.id }} {
  padding: 60px 0;
  text-align: center;
}
#{{ section.id }} .best-seller-heading {
  font-size: 26px;
  font-weight: 600;
  color: #555;
  margin-bottom: 40px;
  text-transform: uppercase;
}
#{{ section.id }} .best-seller-slider {
  position: relative;
  display:flex;
  align-items:center;
}
#{{ section.id }} .product-card {
  padding: 15px 0;
}

#{{ section.id }} .product-image {
  position: relative;
  margin-bottom: 15px;
  width: 100%;
  aspect-ratio: 1 / 1.4; 
  overflow: hidden;
  border-radius: 10px;
}
#{{ section.id }} .product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  transition: opacity 0.4s ease-in-out;
}
#{{ section.id }} .product-image .secondary-img {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}
#{{ section.id }} .product-image:hover .secondary-img {
  opacity: 1;
}
#{{ section.id }} .product-image:hover .primary-img {
  opacity: 0;
}

/* Discount badge */
#{{ section.id }} .discount-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  width: 65px;
  height: 30px;
  background: #EC018E;
  color: #fff;
  font-size: 13px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 5px;
}
#{{ section.id }} .product-title {
  font-size: 16px;
  margin: 10px 0;
  font-weight: 500;
}
#{{ section.id }} .product-title a {
  text-decoration: none;
  color: #000;
  font-weight:600;
}
#{{ section.id }} .product-price {
  font-size: 16px;
}
#{{ section.id }} .product-price .old-price {
  text-decoration: line-through;
  margin-right: 8px;
  color: #888;
}
#{{ section.id }} .product-price .new-price {
  color: #EC018E;
  font-weight: bold;
}

/* Slick arrows */
#{{ section.id }} .slick-prev,
#{{ section.id }} .slick-next {
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  display: flex !important;
  align-items: center;
  justify-content: center;
  z-index: 10;
  top: 45%;
  transform: translateY(-50%);
  font-size:20px;
  position:absolute;
}
#{{ section.id }} .slick-prev {
  left: -50px;
}
#{{ section.id }} .slick-next {
  right: -50px;
}
#{{ section.id }} .slick-prev:before,
#{{ section.id }} .slick-next:before {
  font-family: 'slick';
  font-size: 28px;
  color: #333;
  opacity: 1;
}
</style>

<script>
    $('.best-seller-slider').slick({
      infinite: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      arrows: true,
      dots: false,
      autoplay: true,
      autoplaySpeed: 4000,
      prevArrow: '<button type="button" class="slick-prev">&#10094;</button>',
      nextArrow: '<button type="button" class="slick-next">&#10095;</button>',
      responsive: [
        {
          breakpoint: 992,
          settings: { slidesToShow: 2 }
        },
        {
          breakpoint: 600,
          settings: { slidesToShow: 1 }
        }
      ]
    });
</script>

{% schema %}
{
  "name": "Custom product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Seller from Customer Choice"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Custom product",
      "category": "Custom"
    }
  ]
}
{% endschema %}
