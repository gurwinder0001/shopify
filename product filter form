<section class="find-product-section" style="background-image:url({{ section.settings.bg_image | img_url:'master' }});">
 
  <div class="find-product-form-wrapper container">
     <div class="find-product-image" >
    </div>
    <div class="find-product-card">

      <h2 class="find-product-title">{{ section.settings.title }}</h2>

      <form id="filter-form" action="/collections/all" method="get" novalidate target="_blank">

        <!-- CATEGORY -->
        <label class="find-label">Category</label>
        <select id="category-select" class="find-select" name="category">
          <option value="">Select Category</option>

          <!-- Rudraksha -->
          <option value="rudraksha" data-action="/collections/natural-rudraksha">
            Rudraksha
          </option>

          <!-- Crystal -->
          <option value="crystal" data-action="/collections/gems-crystal-stones">
            Crystal
          </option>

          <!-- Gemstone -->
          <option value="gemstone" data-action="/collections/gems">
            Gemstone
          </option>
        </select>

        <!-- PRODUCT TYPE -->
        <label class="find-label">Product Type</label>
        <select id="product-type-select" class="find-select">
          <option value="">Select Product Type</option>
        </select>

        <!-- PRICE RANGE -->
        <label class="find-label">Price Range</label>
        <select id="price-select" class="find-select">
          <option value="">Select Price Range</option>
        </select>

        <!-- Hidden Shopify price filter inputs -->
        <input type="hidden" name="filter.v.price.gte" id="price-gte">
        <input type="hidden" name="filter.v.price.lte" id="price-lte">

        <button type="submit" class="find-search-btn">SEARCH</button>
      </form>

    </div>
  </div>
</section>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const manualProductTypes = {
    /* GEMSTONE TYPES */
    gemstone: [
      { name: "Yellow Sapphire", url: "/collections/yellow-sapphire-pukhraj" },
      { name: "Blue Sapphire", url: "/collections/blue-sapphire-neelam" },
      { name: "Ruby", url: "/collections/ruby-manik" },
      { name: "Emerald", url: "/collections/emerald-panna" },
      { name: "Red Coral", url: "/collections/red-coral-moonga" },
      { name: "Hessonite", url: "/collections/hessonite" },
      { name: "Pearl", url: "/collections/pearl-moti" },
      { name: "Cat's Eye", url: "/collections/lehsuniya-cats-eye" },
      { name: "Opal", url: "/collections/opal" },
      { name: "Amethyst", url: "/collections/amethyst" },
      { name: "Turquoise", url: "/collections/firoza-turquoise" },
      { name: "Iolite", url: "/collections/iolite" },
      { name: "Pitambari Neelam", url: "/collections/pitambari-neelam" },
      { name: "Citrine", url: "/collections/citrine" },
      { name: "Garnet", url: "/collections/garnet" },
      { name: "Peridot", url: "/collections/peridot" },
      { name: "Zircon", url: "/collections/zircon-jarkan" },
      { name: "Tiger's Eye", url: "/collections/tigers-eye" },
      { name: "Jasper", url: "/collections/jasper" },
      { name: "Moonstone", url: "/collections/moonstone" },
      { name: "Lapis Lazuli", url: "/collections/lapis-lazuli" },
      { name: "Keshi Pearl", url: "/collections/keshi-pearl" },
      { name: "South Sea Pearl", url: "/collections/south-sea-pearl" }
    ],
    /* RUDRAKSHA TYPES */
    rudraksha: [
      { name: "Rudraksha Bead", url: "/collections/natural-rudraksha" },
      { name: "Mala", url: "/collections/rudraksha-mala" },
      { name: "Bracelet", url: "/collections/rudraksha-bracelet" }
    ],
    /* CRYSTAL TYPES */
    crystal: [
      { name: "Bracelet", url: "/collections/bracelets" },
      { name: "Crystal Mala", url: "/collections/crystal-mala" },
      { name: "Crystal Trees", url: "/collections/crystal-trees" },
      { name: "Sphere Ball", url: "/collections/sphere-ball" },
      { name: "Pyramid", url: "/collections/pyramid" }
    ]
  };
  /* ---------------------------
     PRICE RANGE LISTS
     --------------------------- */
  const priceRanges = {
    rudraksha: [
      { label: "All", gte: "", lte: "" },
      { label: "₹0 – ₹1,000", gte: 0, lte: 1000 },
      { label: "₹1,000 – ₹2,000", gte: 1000, lte: 2000 },
      { label: "₹2,000 – ₹5,000", gte: 2000, lte: 5000 },
      { label: "₹5,000 – ₹10,000", gte: 5000, lte: 10000 },
      { label: "₹10,000+", gte: 10000, lte: 999999 }
    ],
    crystal: [
      { label: "All", gte: "", lte: "" },
      { label: "₹0 – ₹500", gte: 0, lte: 500 },
      { label: "₹500 – ₹2,000", gte: 500, lte: 2000 },
      { label: "₹2,000+", gte: 2000, lte: 999999 }
    ],
    gemstone: [
      { label: "All", gte: "", lte: "" },
      { label: "₹0 – ₹2,000", gte: 0, lte: 2000 },
      { label: "₹2,000 – ₹10,000", gte: 2000, lte: 10000 },
      { label: "₹10,000+", gte: 10000, lte: 999999 }
    ]
  };
  /* --------------------------- */
  const catSelect = document.getElementById("category-select");
  const ptSelect = document.getElementById("product-type-select");
  const priceSelect = document.getElementById("price-select");
  const filterForm = document.getElementById("filter-form");
  const priceGte = document.getElementById("price-gte");
  const priceLte = document.getElementById("price-lte");
  function clearSelect(sel) {
    while (sel.options.length > 1) sel.remove(1);
  }


  /* ---------------------------
     ON CATEGORY CHANGE
     --------------------------- */
  catSelect.addEventListener("change", function () {

    const cat = this.value;
    const action = this.options[this.selectedIndex].getAttribute("data-action");

    // Update form action
    filterForm.setAttribute("action", action);

    // Reset lists
    clearSelect(ptSelect);
    clearSelect(priceSelect);

    // PRODUCT TYPES
    if (manualProductTypes[cat]) {
      manualProductTypes[cat].forEach(pt => {
        let opt = document.createElement("option");
        opt.value = pt.url; 
        opt.textContent = pt.name;
        ptSelect.appendChild(opt);
      });
    }

    // PRICE RANGES
    if (priceRanges[cat]) {
      priceRanges[cat].forEach(range => {
        let opt = document.createElement("option");
        opt.textContent = range.label;
        opt.dataset.gte = range.gte;
        opt.dataset.lte = range.lte;
        priceSelect.appendChild(opt);
      });
    }

  });


  /* ---------------------------
     ON PRODUCT TYPE CHANGE
     → Update form action
     --------------------------- */
  ptSelect.addEventListener("change", function () {
    if (this.value) {
      filterForm.setAttribute("action", this.value);
    }
  });


  /* ---------------------------
     PRICE CHANGE
     --------------------------- */
  priceSelect.addEventListener("change", function () {
    const s = this.options[this.selectedIndex];
    priceGte.value = s.dataset.gte || "";
    priceLte.value = s.dataset.lte || "";
  });

});
</script>


<style>
.find-product-section {
  display: flex;
  min-height: 600px;
  position: relative;
  background-size: cover;
  background-position: center;
}

/* RIGHT FORM */
.find-product-form-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 40px;
}

.find-product-card {
  width: 100%;
  max-width: 420px;
  background: #ffffff;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.find-product-title {
  font-size: 28px;
  text-align: center;
  margin-bottom: 20px;
  font-family: "Georgia", serif;
}

.find-label {
  font-size: 14px;
  margin-bottom: 8px;
  display: block;
  color: #333;
}

.find-select {
  width: 100%;
  padding: 12px;
  border: 1px solid #e3e3e3;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 15px;
}

.find-search-btn {
  width: 100%;
  padding: 12px;
  background: #273a6a;
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  cursor: pointer;
  font-weight: bold;
}

.find-search-btn:hover {
  background: #1e2e55;
}

/* MOBILE */
@media (max-width: 768px) {
  .find-product-section {
    flex-direction: column;
  }
  .find-product-form-wrapper {
    padding: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Find the Right Product",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Find the Right Product"
    }
  ],
  "presets": [
    {
      "name": "Find Product Filter"
    }
  ]
}
{% endschema %}
